"VertexLitGeneric"
{
	"$basetexture"	"models\buildables\lsentry3\lSentry3"
//	"$bumpmap"     "models/player/shared/shared_normal"
	"$bumpmap"	"models\buildables\lsentry3\lSentry3_normal"
	"$phong" "1"
	"$phongboost" "10"
	"$phongexponent" "25"
	"$lightwarptexture" "models\buildables\sentry1\Sentry1_lightwarp"
	"$phongfresnelranges"	"[.5 1.5 10]"
	
	"$selfillum" "1"

	"$envmap" "cubemaps/cubemap_gold001"	
	"$envmaptint" "[1.8 1.2 .5]"

	"$rimlight" "1"
	"$rimlightexponent" "30"	
	"$rimlightboost" "2"

	"360?$color2" "[ 0.9 0.8 0.8 ]"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}

	}
}


