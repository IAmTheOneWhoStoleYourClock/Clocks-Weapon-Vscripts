"VertexLitGeneric"
{
	"$basetexture" "effects/caustic04"
	"$basetexturetransform" "center .25 .25 scale 1.25 1.25 rotate 0 translate 0 0"
	
	"$translucent" "1"
	
	"$color2" "[1 1 1]"
	
	"$receiveflashlight" "1"

	"$phong" "1"

	"$blendtintbybasealpha"		"1"
	"$blendtintcoloroverbase"		"1"
	"$colortint_base"		"{230 230 230}"
	"$colortint_tmp"		"[0 0 0]"
	
	"$rimlight" "1"
	"$rimlightexponent" "15"
	"$rimlightboost" "100"
		
	"$selfillum" "0.1"
	"$selfillumfresnel" "3"
	"$selfillumfresnelminmaxexp" "[5 10 5]"
	
	"Proxies"
	{	
		"AnimatedTexture" 
		{ 
			"animatedTextureVar" "$basetexture" 
			"animatedTextureFrameNumVar" "$frame" 
			"animatedTextureFrameRate" "30" 
		}
	}
}
